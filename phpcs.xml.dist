<?xml version="1.0"?>
<ruleset name="Wille Reviews">
	<description>WordPress-Extra (security, DB, i18n, formatting), WordPress VIP security sniffs and PHPCompatibility for the plugin. No baseline, warnings fail the build, and inline phpcs:ignore/disable comments have no effect (scripts/phpcs-strict.mjs runs with --ignore-annotations). The only exceptions live in this file, scoped and explained.</description>

	<file>wille-reviews</file>
	<file>tests</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- Generated by scripts/i18n.mjs. -->
	<exclude-pattern>wille-reviews/languages/*</exclude-pattern>
	<!-- Third-party API stubs for PHPStan: several classes per file, empty bodies. -->
	<exclude-pattern>tests/stubs/elementor.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Windows checkouts may have CRLF; Git normalises on commit (.gitattributes). -->
	<rule ref="Internal.LineEndings.Mixed">
		<severity>0</severity>
	</rule>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- The full WordPress standard: Core + Docs + Extra. -->
	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wille-reviews"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="willerev"/>
				<element value="WILLEREV"/>
			</property>
		</properties>
	</rule>

	<!-- Security/correctness sniffs from WordPress VIP. -->
	<rule ref="WordPressVIPMinimum.Security"/>
	<rule ref="WordPressVIPMinimum.Hooks.AlwaysReturnInFilter"/>
	<rule ref="WordPressVIPMinimum.Functions.CheckReturnValue"/>
	<rule ref="WordPressVIPMinimum.Functions.DynamicCalls"/>
	<rule ref="WordPressVIPMinimum.Functions.StripTags"/>
	<rule ref="WordPressVIPMinimum.Classes.DeclarationCompatibility"/>
	<rule ref="WordPressVIPMinimum.Files.IncludingNonPHPFile"/>

	<!-- Tests run outside WordPress with Brain Monkey: no prefixes, escaping or i18n there. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- PSR-4 test classes (tests/unit/BotsTest.php) instead of class-bots-test.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- Test harness and the WordPress stubs re-implement WP functions with PHP natives and query tables directly. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>tests/stubs/*</exclude-pattern>
	</rule>
	<!-- Docblocks are required for the plugin; test methods and stubs document themselves through their names. -->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- The wp_strip_all_tags() stand-in of the unit tests is built on strip_tags(). -->
	<rule ref="WordPress.WP.AlternativeFunctions.strip_tags_strip_tags">
		<exclude-pattern>tests/unit/*</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Functions.StripTags">
		<exclude-pattern>tests/unit/*</exclude-pattern>
	</rule>

	<!-- The refresh interval is the cache duration setting (sanitized to 1–168 hours), so the sniff cannot read it
	     from the code. It never goes below one hour: WILLEREV_Admin::sanitize_settings(). -->
	<rule ref="WordPress.WP.CronInterval.ChangeDetected">
		<exclude-pattern>wille-reviews/includes/class-willerev-places.php</exclude-pattern>
	</rule>
</ruleset>
