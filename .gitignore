# Dependencies (dev tooling only – the shipped plugin has no build step and no dependencies)
/node_modules/
/vendor/

# Tool caches, portable PHP, e2e output, Playwright traces
/.cache/
/.phpunit.result.cache

# Build output (release ZIPs are CI artifacts / GitHub release assets)
/dist/

# Agent worktrees (local only)
/.claude/worktrees/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets – never commit real credentials (scripts/secret-scan.mjs + gitleaks + GitHub push protection check this).
# The Google API key lives only in the WordPress settings of the site that uses it; tests use "TEST-KEY".
.env
.env.*
!.env.example
auth.json
*.pem
*.key
*.p12
*.pfx
*service-account*.json
wp-config.php
wp-config-local.php
